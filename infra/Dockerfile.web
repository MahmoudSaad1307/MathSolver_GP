FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace=@mathlens/shared --workspace=@mathlens/web --include-workspace-root

COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_RETENTION_DAYS=30
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_RETENTION_DAYS=$VITE_RETENTION_DAYS
RUN npm --workspace=@mathlens/shared run build && npm --workspace=@mathlens/web run build

FROM nginx:1.27-alpine AS runtime
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
