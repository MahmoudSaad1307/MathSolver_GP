{
  "buildCommand": "npm --workspace=@mathlens/shared run build && npm --workspace=@mathlens/web run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mathlens-api-rxbw.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
