# Groq API Configuration
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Set to false to force local-only Ollama mode (no external network requests for private data)
USE_GROQ=true

# Groq Models (comma-separated ordered list, first available will be used with fallback to next)
# IMPORTANT: Model IDs change often. Verify active IDs at: https://console.groq.com/docs/models
GROQ_VISION_MODELS=qwen/qwen3.6-27b,meta-llama/llama-4-scout-17b-16e-instruct
GROQ_REASON_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b

# Ollama Local Fallback Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_REASON_MODEL=qwen2.5:7b

# MathCheck Engine Parameters
MAX_SOLVE_RETRIES=3
NUMERIC_SAMPLES=14
