# =============================================================================
# MathLens Environment Configuration
# =============================================================================

# --- Database & Redis ---
POSTGRES_USER=mathlens
POSTGRES_PASSWORD=mathlens_dev_password_change_me
POSTGRES_DB=mathlens
DATABASE_URL=postgresql://mathlens:mathlens_dev_password_change_me@localhost:5432/mathlens?schema=public
REDIS_URL=redis://localhost:6379

# --- Storage (S3 / MinIO) ---
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mathlens-answers
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_change_me
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_DIR=./storage-dev

# --- Security & Auth ---
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev_access_secret_min_32_chars_change_in_prod
JWT_REFRESH_SECRET=dev_refresh_secret_min_32_chars_change_in_prod
STUDENT_JWT_SECRET=dev_student_secret_min_32_chars_change_in_prod
VIDEO_UNLOCK_HMAC_SECRET=dev_unlock_secret_min_32_chars_change_in_prod
IP_HASH_SALT=dev_ip_salt_min_32_chars_change_in_prod
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- API Service ---
API_PORT=4000
NODE_ENV=development
LOG_LEVEL=info
TRUST_PROXY=false
RETENTION_DAYS=30
MAX_IMAGE_BYTES=8388608
MAX_IMAGES_PER_ANSWER=2
MAX_PDF_BYTES=20971520
MAX_PDF_PAGES=40
PDF_EXTRACTION_TIMEOUT_MS=180000
VIRUS_SCAN_DRIVER=noop
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Grading Queue & AI Integration ---
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_KEY=dev_internal_shared_secret_change_in_prod
GRADING_CONCURRENCY=3
AI_DAILY_CAP_USD=25.0
AI_STUDENT_DAILY_CALL_CAP=20
AI_REQUEST_TIMEOUT_MS=45000

# --- AI Grading Service (FastAPI) ---
# Supported providers: gemini | anthropic | groq | fake (GEMINI_API_KEY takes highest priority when set)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-flash-latest
GEMINI_GRADE_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
GROQ_API_KEY=
AI_MODEL_TRANSCRIBE=claude-sonnet-4-20250514
AI_MODEL_GRADE=claude-sonnet-4-20250514
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_GRADE_MODEL=qwen/qwen3.8-27b
AI_MIN_CONFIDENCE=0.75
AI_MAX_ILLEGIBLE_RATIO=0.20
AI_PASS_GRADE_IMAGE=true
AI_BLUR_LAPLACIAN_MIN=45.0
AI_MAX_INPUT_TOKENS_PER_CALL=4096

# --- Default Seed Teacher ---
SEED_TEACHER_EMAIL=teacher@mathlens.local
SEED_TEACHER_PASSWORD=TeacherPass123!
SEED_TEACHER_NAME=أ. أحمد محمود

# --- Observability (optional) ---
SENTRY_DSN=

# --- Web Frontend (Vite build/dev) ---
VITE_API_BASE_URL=/api/v1
VITE_RETENTION_DAYS=30
